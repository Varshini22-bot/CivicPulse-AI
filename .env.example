# ==============================================================================
# CivicPulse AI — Environment Configuration Template
# Copy this file to .env and configure values for your deployment environment
# ==============================================================================

# Application Metadata
PROJECT_NAME="CivicPulse AI"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & Authentication (Generate random 32+ char secret in production)
# Example: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-32-char-secret-key-in-production!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection
# SQLite (Local Development default):
DATABASE_URL="sqlite:///./civicpulse.db"
# PostgreSQL / PostGIS (Docker / Production):
# DATABASE_URL="postgresql://civicpulse:civicpulse_secret@localhost:5432/civicpulse_db"

# Storage Directories
UPLOAD_DIR="uploads"
DEMO_DIR="uploads/demo"

# CORS Authorized Origins (Comma-separated or list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# 5-Factor Priority Engine Weights (Sum must equal 1.00)
WEIGHT_SEVERITY=0.35
WEIGHT_SAFETY=0.25
WEIGHT_LOCATION_RISK=0.15
WEIGHT_COMMUNITY_IMPACT=0.15
WEIGHT_AGE=0.10

# Duplicate Issue Detection Parameters
DUPLICATE_RADIUS_METERS=100.0
DUPLICATE_TIME_WINDOW_DAYS=30
DUPLICATE_SCORE_THRESHOLD=0.65

# Default Municipal Geocenter (Bengaluru, Karnataka)
DEFAULT_LAT=12.9716
DEFAULT_LNG=77.5946
